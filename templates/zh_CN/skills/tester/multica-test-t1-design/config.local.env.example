# multica-test-t1-design 可选本地凭证模板（默认不需要）
# 推荐：在 Windows 系统环境变量中配置账号，Skill 会优先读取系统变量
# 仅当系统变量缺失时，才可复制本文件为 config.local.env 作为兜底
# 警告: 含密码/Token，勿提交仓库（已在 .gitignore）

# ---- Jira / Confluence（至少配一组）----
# 推荐：域账户
# JIRA_USERNAME=
# JIRA_PASSWORD=

# 或：自部署用户名密码
# JIRA_USERNAME=
# JIRA_PASSWORD=

# 或：Cloud
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# 兜底 Cookie（易过期，不推荐）
# JIRA_COOKIE=
# CONFLUENCE_COOKIE=

# ---- Figma（按需）----
# FIGMA_TOKEN=

# ---- 团队知识库 Bridge（按需，有默认值时可省略）----
# TEAM_KB_URL=https://team-kb.example.com
# TEAM_KB_TIMEOUT=600
