# Domain account (priority — used for both JIRA and Confluence when set)
# JIRA_USERNAME=<your-domain-username>
# JIRA_PASSWORD=<your-domain-password>

# Confluence (fallback when domain vars unset)
CONFLUENCE_URL=http://confluence.example.com:8090
CONFLUENCE_USER=<your-username>
CONFLUENCE_PASS=<your-password>
CONFLUENCE_AUTH_MODE=basic

# JIRA (fallback when domain vars unset)
JIRA_URL=http://jira.example.com:8080
JIRA_USER=<your-username>
JIRA_PASS=<your-password>

# DingTalk webhook tokens (map keys in config.yaml dingtalk.project_webhook_map)
DINGTALK_PROJ_WEBHOOK=<webhook-token>
DINGTALK_MDP_WEBHOOK=<webhook-token>
